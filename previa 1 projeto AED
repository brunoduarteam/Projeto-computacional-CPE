using namespace std;


    class Item {   //classe dos itens do que pode estar dentro do acervo 
private:
    int id;
    string titulo;
    bool disponivel;


public:
    Item(int novoId, string novoTitulo) { // esse e o construtor e nesse caso serve para facilitar a criacao de um novo item
        id = novoId;
        titulo = novoTitulo;
        disponivel = true;
    }

     int getId() { // aqui pegamos o id e retornamos ele 
        return id;
    }

    string getTitulo() { 
        return titulo;
    }

    bool estaDisponivel() { //ultilizamos bool pois ele so e verdadeiro ou falso
        return disponivel;
    }

     void setDisponivel(bool novoStatus) { // aqui criamos o setdisponivel para alterar o disponivel (se esta ou nao disponivel)
        disponivel = novoStatus;
    }
    
    virtual void mostrarDados() {
    cout << "ID: " << id << endl;
    cout << "Titulo: " << titulo << endl;
}

};  



class Livro : public Item {  // livro herda item
private:
    string autor;

public:
    Livro(int novoId, string novoTitulo, string novoAutor)
        : Item(novoId, novoTitulo) // chama o construtor da classe Item para inicializar a parte de Item que existe dentro de Livro
    {
        autor = novoAutor;
    }
      string getAutor() { //pega o nome e retorna
        return autor;
    } 

    void mostrarDados() override {
    cout << "ID: " << getId() << endl;
    cout << "Titulo: " << getTitulo() << endl;
    cout << "Autor: " << autor << endl;
}

};

